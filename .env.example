# WINDLENS Environment Configuration Template
# Copy this file to .env and adjust variables as required.
# No secrets or actual keys are included here.

# --- Server Configuration ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Elexon BMRS API ---
# Official Elexon Insights Solution public endpoints do not require an API key.
# If an API key is ever provisioned, provide it below (backend-only).
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_API_KEY=

# --- Analysis & Baseline Period ---
ANALYSIS_START_DATE=2026-01-01
ANALYSIS_END_DATE=2026-01-31
FORECAST_LOOKBACK_DAYS=3

# --- Decision Cutoff Policy ---
# Available policy: end_of_preceding_day (23:59:59.999999 Europe/London of D-1)
DECISION_CUTOFF_POLICY=end_of_preceding_day

# --- Local Persistent Data Storage ---
DATA_DIR=data
CACHE_TTL_SECONDS=3600

# --- HTTP Client Settings ---
HTTP_TIMEOUT_SECONDS=60
HTTP_MAX_RETRIES=3
HTTP_RETRY_DELAY_SECONDS=2.0
REQUEST_RATE_LIMIT_SECONDS=0.5

# --- Frontend Deployment (Vite) ---
# Leave blank for local development (uses Vite proxy to /api)
# For production deployment, set to backend domain: e.g., https://your-backend.railway.app
VITE_API_BASE_URL=
